#include<stdio.h>

int partition(int a[] ,int low,int high)
{
    int i,j,temp,key;
    i=low+1;
    j=high;
    key=a[low];
    while(1)
    {
        while(a[i]<=key && i<=high)
            i++;
        while(a[j]>key)
            j--;
        if(i<j){
            temp=a[i];
            a[i]=a[j];
            a[j]=temp;
        }
        else{
            temp=a[low];
            a[low]=a[j];
            a[j]=temp;
            return j;
        }
    }
}

void QuickSort(int a[],int low,int high)
{
    int j;
    if(low<high)
    {
         j=partition(a,low,high);
         QuickSort(a,low,j-1);
         QuickSort(a,j+1,high);
    }
}
int main()
{
    int n,a[100];
    printf("Enter the number of elements in the array:");
    scanf("%d",&n);
    printf("Enter the array elements:");
    for(int i=0;i<n;i++)
        scanf("%d",&a[i]);
    QuickSort(a,0,n-1);

    printf("Sorted Array:");
    for(int i=0;i<n;i++)
        printf("%d\t",a[i]);
    return 0;
}

