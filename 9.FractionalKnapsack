#include <stdio.h>

int main() {
    int i, j, n, m;
    int p[50], w[50];
    float x[50];
    int t1, t2;

    printf("Enter the number of objects: ");
    scanf("%d", &n);

    printf("Enter the weights of all objects:\n");
    for (i = 0; i < n; i++) {
        scanf("%d", &w[i]);
    }

    printf("Enter the profit of all objects:\n");
    for (i = 0; i < n; i++) {
        scanf("%d", &p[i]);
    }


    for (i = 0; i < n - 1; i++) {
        for (j = i + 1; j < n; j++) {
            if ((float)p[i] / w[i] < (float)p[j] / w[j]) {

                t1 = p[i];
                p[i] = p[j];
                p[j] = t1;


                t2 = w[i];
                w[i] = w[j];
                w[j] = t2;
            }
        }
    }

    printf("Enter the maximum capacity: ");
    scanf("%d", &m);

    for (i = 0; i < n; i++) {
        x[i] = 0.0;
    }

    int rem_cap = m;

    for (i = 0; i < n; i++) {
        if (w[i] > rem_cap) {
            break;
        }
        x[i] = 1.0;
        rem_cap -= w[i];
    }


    if (i < n) {
        x[i] = (float)rem_cap / w[i];
    }


    float sum = 0;
    for (i = 0; i < n; i++) {
        sum = sum + (p[i] * x[i]);
    }

    printf("Total profit : %f\n", sum);

    return 0;
}
